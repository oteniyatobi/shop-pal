# Copy this file to .env (in the repo root) and fill in your values.
# Never commit your real .env file.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal sandbox app — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: only needed if the frontend is hosted on a different origin than the API
# FRONTEND_ORIGIN=http://localhost:5173
